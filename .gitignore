# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

/.game-test-build/
*.tsbuildinfo

# Generated author download; rebuilt before local dev and production builds.
/public/templates/*.zip
# Browser-exported snapshots stay local; public tests generate synthetic worlds.
/tests/game/fixtures/*.json

# Build-generated presentation derivatives; authored PNGs remain in content-packs.
/public/art/optimized/

# Private per-browser AI configuration, never bundled, exported, or committed.
/.xiantu-private/
